Bridge modbus:tcp:kermiHeatpump "Kermi Wärmepumpe Modbus TCP" [
  host="192.168.100.199",
  port=502,
  id=40,
  timeBetweenTransactionsMillis=60,
  connectMaxTries=3,
  reconnectAfterMillis=60000
] {

  // ============================================================
  // WP Energiequelle (Reg 1–3)
  // ============================================================
  Bridge poller kermi_wp_source_temps "WP Energiequelle Temperaturen Poller" [
    start=1,
    length=3,
    type="holding",
    refresh=60000
  ] {
    Thing data kermi_wp_source_out "Energiequelle Austritt" [
      readStart=1,
      readValueType="int16",
      readTransform="JS(div10.js)"
    ]
    Thing data kermi_wp_source_in "Energiequelle Eintritt" [
      readStart=2,
      readValueType="int16",
      readTransform="JS(div10.js)"
    ]
    Thing data kermi_wp_outdoor "Außentemperaturfühler" [
      readStart=3,
      readValueType="int16",
      readTransform="JS(div10.js)"
    ]
  }

  // ============================================================
  // WP Ladekreis (Reg 50–52)
  // ============================================================
  Bridge poller kermi_wp_ladekreis "WP Ladekreis Poller" [
    start=50,
    length=3,
    type="holding",
    refresh=60000
  ] {
    Thing data kermi_wp_flow "Vorlauftemperatur WP" [
      readStart=50,
      readValueType="int16",
      readTransform="JS(div10.js)"
    ]
    Thing data kermi_wp_return "Rücklauftemperatur WP" [
      readStart=51,
      readValueType="int16",
      readTransform="JS(div10.js)"
    ]
    Thing data kermi_wp_flowrate "Durchfluss WP" [
      readStart=52,
      readValueType="int16",
      readTransform="JS(div10.js)"
    ]
  }

  // ============================================================
  // WP Leistung & Effizienz (Reg 100–111)
  // ============================================================
  Bridge poller kermi_wp_power "WP Leistung & Effizienz Poller" [
    start=100,
    length=12,
    type="holding",
    refresh=60000
  ] {
    Thing data kermi_wp_cop "Aktueller COP" [
      readStart=100,
      readValueType="int16",
      readTransform="JS(div10.js)"
    ]
    Thing data kermi_wp_cop_heat "Aktueller COP Heizen" [
      readStart=101,
      readValueType="int16",
      readTransform="JS(div10.js)"
    ]
    Thing data kermi_wp_cop_twe "Aktueller COP TWE" [
      readStart=102,
      readValueType="int16",
      readTransform="JS(div10.js)"
    ]
    Thing data kermi_wp_cop_cool "Aktueller COP Kühlen" [
      readStart=103,
      readValueType="int16",
      readTransform="JS(div10.js)"
    ]
    Thing data kermi_wp_p "Aktuelle Leistung" [
      readStart=104,
      readValueType="int16",
      readTransform="JS(div10.js)"
    ]
    Thing data kermi_wp_p_heat "Aktuelle Leistung Heizen" [
      readStart=105,
      readValueType="int16",
      readTransform="JS(div10.js)"
    ]
    Thing data kermi_wp_p_twe "Aktuelle Leistung TWE" [
      readStart=106,
      readValueType="int16",
      readTransform="JS(div10.js)"
    ]
    Thing data kermi_wp_p_cool "Aktuelle Leistung Kühlen" [
      readStart=107,
      readValueType="int16",
      readTransform="JS(div10.js)"
    ]
    Thing data kermi_wp_p_el "Aktuelle elektrische Leistung" [
      readStart=108,
      readValueType="int16",
      readTransform="JS(div10.js)"
    ]
    Thing data kermi_wp_p_el_heat "Aktuelle elektrische Leistung Heizen" [
      readStart=109,
      readValueType="int16",
      readTransform="JS(div10.js)"
    ]
    Thing data kermi_wp_p_el_twe "Aktuelle elektrische Leistung TWE" [
      readStart=110,
      readValueType="int16",
      readTransform="JS(div10.js)"
    ]
    Thing data kermi_wp_p_el_cool "Aktuelle elektrische Leistung Kühlen" [
      readStart=111,
      readValueType="int16",
      readTransform="JS(div10.js)"
    ]
  }

  // ============================================================
  // WP Betriebsstunden (Reg 150–152)
  // ============================================================
  Bridge poller kermi_wp_runtime "WP Betriebsstunden Poller" [
    start=150,
    length=3,
    type="holding",
    refresh=60000
  ] {
    Thing data kermi_wp_hours_fan "Betriebsstunden Lüfter" [
      readStart=150,
      readValueType="uint16"
    ]
    Thing data kermi_wp_hours_buffer_pump "Betriebsstunden Speicherladepumpe" [
      readStart=151,
      readValueType="uint16"
    ]
    Thing data kermi_wp_hours_compressor "Betriebsstunden Verdichter" [
      readStart=152,
      readValueType="uint16"
    ]
  }

  // ============================================================
  // WP Status (Reg 200)
  // ============================================================
  Bridge poller kermi_wp_status_code_poll "WP Statuscode Poller" [
    start=200,
    length=1,
    type="holding",
    refresh=60000
  ] {
    Thing data kermi_wp_status_code "Status Wärmepumpe" [
      readStart=200,
      readValueType="int16",
  	  readTransform="JS(kermi_wp_status200.js)"
    ]
  }

  // ============================================================
  // WP Alarm (Reg 250)
  // ============================================================
  Bridge poller kermi_wp_alarm_poll "WP Alarm Poller" [
    start=250,
    length=1,
    type="holding",
    refresh=60000
  ] {
    Thing data kermi_wp_alarm "Globaler Alarm" [
      readStart=250,
      readValueType="int16"
    ]
  }

  // ============================================================
  // WP PV Modulation (Reg 300–303)
  // ============================================================
  Bridge poller kermi_wp_pv_mod "WP PV Modulation Poller" [
    start=300,
    length=4,
    type="holding",
    refresh=60000
  ] {
    Thing data kermi_wp_pv_mod_active "PV Modulation" [
      readStart=300,
      readValueType="int16"
    ]
    Thing data kermi_wp_pv_mod_power "PV-Mod aktuelle Leistung" [
      readStart=301,
      readValueType="int16",
	    readTransform="JS(div10.js)",
      writeStart=301,
      writeValueType="int16",
	    writeTransform="JS(mul10.js)",
      writeType="holding"
    ]
    Thing data kermi_wp_pv_mod_temp_hz "PV-Mod Solltemperatur Heizen" [
      readStart=302,
      readValueType="int16",
      readTransform="JS(div10.js)",
      writeStart=302,
      writeValueType="int16",
      writeTransform="JS(mul10.js)",
      writeType="holding"
    ]
    Thing data kermi_wp_pv_mod_temp_twe "PV-Mod Solltemperatur TWE" [
      readStart=303,
      readValueType="int16",
      readTransform="JS(div10.js)",
      writeStart=303,
      writeValueType="int16",
      writeTransform="JS(mul10.js)",
      writeType="holding"
    ]
  }
}

Bridge modbus:tcp:kermiStoreHeating "Kermi Speicher Heizen Modbus TCP" [
  host="192.168.100.199",
  port=502,
  id=50,
  timeBetweenTransactionsMillis=60,
  connectMaxTries=3,
  reconnectAfterMillis=60000
] {

  // ============================================================
  // Speicher Heizen (Reg 1–2)
  // ============================================================
  Bridge poller kermi_store_heat "Speicher Heizen Poller" [
    start=1,
    length=2,
    type="holding",
    refresh=60000
  ] {
    Thing data kermi_store_heat_temp "Isttemperatur Heizspeicher" [
      readStart=1,
      readValueType="int16",
      readTransform="JS(div10.js)"
    ]
    Thing data kermi_store_heat_setpoint "Solltemperatur Heizspeicher" [
      readStart=2,
      readValueType="int16",
      readTransform="JS(div10.js)"
    ]
  }

  // ============================================================
  // Speicher Kühlen (Reg 50–51)
  // ============================================================
  Bridge poller kermi_store_cool "Speicher Kühlen Poller" [
    start=50,
    length=2,
    type="holding",
    refresh=60000
  ] {
    Thing data kermi_store_cool_temp "Isttemperatur Kühlspeicher" [
      readStart=50,
      readValueType="int16",
      readTransform="JS(div10.js)"
    ]
    Thing data kermi_store_cool_setpoint "Solltemperatur Kühlspeicher" [
      readStart=51,
      readValueType="int16",
      readTransform="JS(div10.js)"
    ]
  }

  // ============================================================
  // Speicher TWE (Reg 100–104)
  // ============================================================
  Bridge poller kermi_store_twe "Speicher TWE Poller" [
    start=100,
    length=5,
    type="holding",
    refresh=60000
  ] {
    Thing data kermi_store_twe_temp "Isttemperatur TWE" [
      readStart=100,
      readValueType="int16",
      readTransform="JS(div10.js)"
    ]
    Thing data kermi_store_twe_setpoint "Solltemperatur TWE" [
      readStart=101,
      readValueType="int16",
      readTransform="JS(div10.js)"
    ]
    Thing data kermi_store_twe_const_setpoint "TWE Konstant-Sollwert" [
      readStart=102,
      readValueType="int16",
      readTransform="JS(div10.js)",
      writeStart=102,
      writeValueType="int16",
      writeTransform="JS(mul10.js)",
      writeType="holding"
    ]
    Thing data kermi_store_twe_one_shot "TWE Einmalladung" [
      readStart=103,
      readValueType="int16",
      readTransform="JS(gt0_to_onoff.js)",
      writeStart=103,
      writeValueType="int16",
      writeTransform="JS(onoff_to_01.js)",
      writeType="holding"
    ]
    Thing data kermi_store_twe_one_shot_setpoint "TWE Einmalladung Sollwert" [
      readStart=104,
      readValueType="int16",
      readTransform="JS(div10.js)",
      writeStart=104,
      writeValueType="int16",
      writeTransform="JS(mul10.js)",
      writeType="holding"
    ]
  }

  // ============================================================
  // Heizkreis (Reg 150–163)
  // ============================================================
  Bridge poller kermi_hk "Heizkreis Poller" [
    start=150,
    length=14,
    type="holding",
    refresh=60000
  ] {
    Thing data kermi_hk_status "Status Heizkreis" [
      readStart=150,
      readValueType="int16",
	    readTransform="JS(kermi_hk_status150.js)"
    ]
    Thing data kermi_hk_temp "Isttemperatur Heizkreis" [
      readStart=151,
      readValueType="int16",
      readTransform="JS(div10.js)"
    ]
    Thing data kermi_hk_setpoint "Solltemperatur Heizkreis" [
      readStart=152,
      readValueType="int16",
      readTransform="JS(div10.js)"
    ]
    Thing data kermi_hk_mode "Betriebsmodus Heizkreis" [
      readStart=153,
      readValueType="int16",
	  readTransform="JS(kermi_hk_betriebsmodus153.js)"
    ]
    Thing data kermi_hk_opmode "Betriebsart Heizkreis" [
      readStart=154,
      readValueType="int16",
	    readTransform="JS(kermi_hk_betriebsart154.js)",
      writeStart=154,
      writeValueType="int16",
      writeType="holding"
    ]
    Thing data kermi_hk_energymode "Energiemodus Heizkreis" [
      readStart=155,
      readValueType="int16",
	    readTransform="JS(kermi_hk_energiemodus155.js)",
      writeStart=155,
      writeValueType="int16",
      writeType="holding"
    ]
    Thing data kermi_hk_curve_shift "Parallelverschiebung Kurve" [
      readStart=156,
      readValueType="int16",
      readTransform="JS(div10.js)",
      writeStart=156,
      writeValueType="int16",
      writeTransform="JS(mul10.js)",
      writeType="holding"
    ]
    Thing data kermi_hk_season "Saisonauswahl" [
      readStart=157,
      readValueType="int16",
  	  readTransform="JS(kermi_hk_season157.js)",
      writeStart=157,
      writeValueType="int16",
      writeType="holding"
    ]
    Thing data kermi_hk_summer_off "Sommerbetrieb Heizen Aus" [
      readStart=158,
      readValueType="int16",
      writeStart=158,
      writeValueType="int16",
      writeType="holding"
    ]
    Thing data kermi_hk_winter_on "Winterbetrieb Heizen Ein" [
      readStart=159,
      readValueType="int16",
      writeStart=159,
      writeValueType="int16",
      writeType="holding"
    ]
    Thing data kermi_hk_cool_on "Kühlbetrieb Ein" [
      readStart=160,
      readValueType="int16",
      writeStart=160,
      writeValueType="int16",
      writeType="holding"
    ]
    Thing data kermi_hk_cool_off "Kühlbetrieb Aus" [
      readStart=161,
      readValueType="int16",
      writeStart=161,
      writeValueType="int16",
      writeType="holding"
    ]
    Thing data kermi_hk_summer_active "Sommerbetrieb" [
      readStart=162,
      readValueType="int16"
    ]
    Thing data kermi_hk_cool_active "Kühlbetrieb" [
      readStart=163,
      readValueType="int16"
    ]
  }

  // ============================================================
  // Externer Wärmeerzeuger (Reg 200–203)
  // ============================================================
  Bridge poller kermi_ext_wez "Externer Wärmeerzeuger Poller" [
    start=200,
    length=4,
    type="holding",
    refresh=60000
  ] {
    Thing data kermi_ext_wez_status_heat "Status externer Wärmeerzeuger Heizen" [
      readStart=200,
      readValueType="int16",
  	  readTransform="JS(kermi_ext_wez_status.js)"
    ]
    Thing data kermi_ext_wez_mode_heat "Betriebsart externer Wärmeerzeuger Heizen" [
      readStart=201,
      readValueType="int16",
  	  readTransform="JS(kermi_ext_wez_betriebsart.js)",
      writeStart=201,
      writeValueType="int16",
      writeType="holding"
    ]
    Thing data kermi_ext_wez_status_twe "Status externer Wärmeerzeuger TWE" [
      readStart=202,
      readValueType="int16",
  	  readTransform="JS(kermi_ext_wez_status.js)"
    ]
    Thing data kermi_ext_wez_mode_twe "Betriebsart externer Wärmeerzeuger TWE" [
      readStart=203,
      readValueType="int16",
	    readTransform="JS(kermi_ext_wez_betriebsart.js)",
      writeStart=203,
      writeValueType="int16",
      writeType="holding"
    ]
  }

  // ============================================================
  // Speicher Status Temperaturen (Reg 250–255)
  // ============================================================
  Bridge poller kermi_store_status_temp "Speicher Status Temperaturen Poller" [
    start=250,
    length=6,
    type="holding",
    refresh=60000
  ] {
    Thing data kermi_store_t1 "T1 X13" [
      readStart=250,
      readValueType="int16",
      readTransform="JS(div10.js)"
    ]
    Thing data kermi_store_t2 "T2 X12" [
      readStart=251,
      readValueType="int16",
      readTransform="JS(div10.js)"
    ]
    Thing data kermi_store_t3 "T3 X11" [
      readStart=252,
      readValueType="int16",
      readTransform="JS(div10.js)"
    ]
    Thing data kermi_store_t4 "T4 X10" [
      readStart=253,
      readValueType="int16",
      readTransform="JS(div10.js)"
    ]
    Thing data kermi_store_outdoor "Speicher Außentemperatur" [
      readStart=254,
      readValueType="int16",
      readTransform="JS(div10.js)"
    ]
    Thing data kermi_store_outdoor_avg "Speicher gemittelte Außentemperatur" [
      readStart=255,
      readValueType="int16",
      readTransform="JS(div10.js)"
    ]
  }

  // ============================================================
  // Speicher Laufzeiten (Reg 300–301)
  // ============================================================
  Bridge poller kermi_store_status_runtime "Speicher Laufzeiten Poller" [
    start=300,
    length=2,
    type="holding",
    refresh=60000
  ] {
    Thing data kermi_store_pump_hours "Heizkreispumpe Laufzeit" [
      readStart=300,
      readValueType="uint16"
    ]
    Thing data kermi_ext_wez_hours "Externer Wärmeerzeuger Laufzeit" [
      readStart=301,
      readValueType="uint16"
    ]
  }
}

