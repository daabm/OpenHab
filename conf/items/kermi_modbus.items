    { channel="modbus:data:kermiStoreHeating:kermi_ext_wez:kermi_ext_wez_status_twe:string" }

String Kermi_ExtWEZ_Mode_TWE       "Betriebsart ext. WEZ TWE [%s]"               <settings> (gKermiStoreHeat_All, gKermiStoreHeat_Control, gKermiStoreHeat_Equip) ["Control"]
    { channel="modbus:data:kermiStoreHeating:kermi_ext_wez:kermi_ext_wez_mode_twe:string" }

