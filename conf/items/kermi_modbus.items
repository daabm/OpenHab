// ============================================================
// Bridge 3 – Kermi Speicher TWE – Groups
// Your things block uses a second "kermiStoreHeating" bridge with id=51.
// For clarity we assume the bridgeID here is "kermiStoreTWE".
// ============================================================

Group gKermiStoreTWE_All      "Kermi Speicher TWE – Alle"          <heating>     (UGWaschkueche)
Group gKermiStoreTWE_Temp     "Kermi Speicher TWE – Temperaturen"  <temperature> (gKermiStoreTWE_All)
Group gKermiStoreTWE_Control  "Kermi Speicher TWE – Steuerung"     <settings>    (gKermiStoreTWE_All)

// Semantic equipment group for TWE storage
Group gKermiStoreTWE_Equip    "TWE Speicher"                        <water>      (gHVAC) ["WaterHeater"]



// ============================================================
// Bridge 3 – Kermi Speicher TWE – Items
// Thing UID prefix assumed: modbus:data:kermiStoreTWE:...
// ============================================================

// --- Speicher Heizen ---
Number KermiTWE_StoreHeat_Temp        "TWE Isttemperatur Heizspeicher [%.1f °C]"      <temperature_hot> (gKermiStoreTWE_All, gKermiStoreTWE_Temp, gKermiStoreTWE_Equip) ["Measurement","Temperature"]
    { channel="modbus:data:kermiStoreTWE:kermiTWE_store_heat:kermiTWE_store_heat_temp:number" }

Number KermiTWE_StoreHeat_Setpoint    "TWE Solltemperatur Heizspeicher [%.1f °C]"     <temperature_hot> (gKermiStoreTWE_All, gKermiStoreTWE_Control, gKermiStoreTWE_Equip) ["Setpoint","Temperature"]
    { channel="modbus:data:kermiStoreTWE:kermiTWE_store_heat:kermiTWE_store_heat_setpoint:number" }

// --- Speicher Kühlen ---
