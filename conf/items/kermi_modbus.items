// ============================================================
// Top-level groups / locations
// ============================================================

// HVAC main group (Equipment) – adapt parent "Home" to your real home group if different
Group gHVAC           "Heizungsanlage"          <heatpump>      ["HeatPump"]

// ============================================================
// Bridge 1 – Kermi Heatpump – Groups
// Bridge ID assumed: kermiHeatpump
// ============================================================

// Technical groups
Group gKermiHeatpump_All      "Kermi Wärmepumpe – Alle"          <heating>     (UGWaschkueche)
Group gKermiHeatpump_Temp     "Kermi Wärmepumpe – Temperaturen"  <temperature> (gKermiHeatpump_All)
Group gKermiHeatpump_Control  "Kermi Wärmepumpe – Steuerung"     <settings>    (gKermiHeatpump_All)

// Semantic Equipment group for the heat pump itself
Group gKermiHeatpump_Equip    "Kermi Wärmepumpe"                 <heatpump>    (gHVAC) ["HeatPump"]



// ============================================================
// Bridge 1 – Kermi Heatpump – Items
// Thing UID prefix assumed: modbus:data:kermiHeatpump:...
// ============================================================

// --- WP Energiequelle ---
Number Kermi_WP_Source_Out      "Energiequelle Austritt [%.1f °C]"       <temperature> (gKermiHeatpump_All, gKermiHeatpump_Temp, gKermiHeatpump_Equip) ["Measurement","Temperature"]
    { channel="modbus:data:kermiHeatpump:kermi_wp_source_temps:kermi_wp_source_out:number" }

Number Kermi_WP_Source_In       "Energiequelle Eintritt [%.1f °C]"       <temperature> (gKermiHeatpump_All, gKermiHeatpump_Temp, gKermiHeatpump_Equip) ["Measurement","Temperature"]
    { channel="modbus:data:kermiHeatpump:kermi_wp_source_temps:kermi_wp_source_in:number" }

Number Kermi_WP_Outdoor         "Außentemperaturfühler [%.1f °C]"        <temperature> (gKermiHeatpump_All, gKermiHeatpump_Temp, gKermiHeatpump_Equip) ["Measurement","OutdoorTemperature"]
    { channel="modbus:data:kermiHeatpump:kermi_wp_source_temps:kermi_wp_outdoor:number" }

// --- WP Ladekreis ---
Number Kermi_WP_Flow            "Vorlauftemperatur WP [%.1f °C]"         <flow> (gKermiHeatpump_All, gKermiHeatpump_Temp, gKermiHeatpump_Equip) ["Measurement","SupplyTemperature"]
    { channel="modbus:data:kermiHeatpump:kermi_wp_ladekreis:kermi_wp_flow:number" }

Number Kermi_WP_Return          "Rücklauftemperatur WP [%.1f °C]"        <returnpipe> (gKermiHeatpump_All, gKermiHeatpump_Temp, gKermiHeatpump_Equip) ["Measurement","ReturnTemperature"]
    { channel="modbus:data:kermiHeatpump:kermi_wp_ladekreis:kermi_wp_return:number" }

Number Kermi_WP_Flowrate        "Durchfluss WP [%.1f l/min]"             <flow> (gKermiHeatpump_All, gKermiHeatpump_Control, gKermiHeatpump_Equip) ["Measurement","Flow"]
    { channel="modbus:data:kermiHeatpump:kermi_wp_ladekreis:kermi_wp_flowrate:number" }

// --- WP Leistung & Effizienz ---
Number Kermi_WP_COP             "Aktueller COP [%.1f]"                    <energy> (gKermiHeatpump_All, gKermiHeatpump_Control, gKermiHeatpump_Equip) ["Measurement","Efficiency"]
    { channel="modbus:data:kermiHeatpump:kermi_wp_power:kermi_wp_cop:number" }

Number Kermi_WP_COP_Heat        "Aktueller COP Heizen [%.1f]"            <energy> (gKermiHeatpump_All, gKermiHeatpump_Control, gKermiHeatpump_Equip) ["Measurement","Efficiency"]
    { channel="modbus:data:kermiHeatpump:kermi_wp_power:kermi_wp_cop_heat:number" }

Number Kermi_WP_COP_TWE         "Aktueller COP TWE [%.1f]"               <energy> (gKermiHeatpump_All, gKermiHeatpump_Control, gKermiHeatpump_Equip) ["Measurement","Efficiency"]
    { channel="modbus:data:kermiHeatpump:kermi_wp_power:kermi_wp_cop_twe:number" }

Number Kermi_WP_COP_Cool        "Aktueller COP Kühlen [%.1f]"            <energy> (gKermiHeatpump_All, gKermiHeatpump_Control, gKermiHeatpump_Equip) ["Measurement","Efficiency"]
    { channel="modbus:data:kermiHeatpump:kermi_wp_power:kermi_wp_cop_cool:number" }

Number Kermi_WP_P               "Aktuelle Leistung [%.1f kW]"            <energy> (gKermiHeatpump_All, gKermiHeatpump_Control, gKermiHeatpump_Equip) ["Measurement","Power"]
    { channel="modbus:data:kermiHeatpump:kermi_wp_power:kermi_wp_p:number" }

Number Kermi_WP_P_Heat          "Aktuelle Leistung Heizen [%.1f kW]"     <energy> (gKermiHeatpump_All, gKermiHeatpump_Control, gKermiHeatpump_Equip) ["Measurement","Power"]
    { channel="modbus:data:kermiHeatpump:kermi_wp_power:kermi_wp_p_heat:number" }

Number Kermi_WP_P_TWE           "Aktuelle Leistung TWE [%.1f kW]"        <energy> (gKermiHeatpump_All, gKermiHeatpump_Control, gKermiHeatpump_Equip) ["Measurement","Power"]
    { channel="modbus:data:kermiHeatpump:kermi_wp_power:kermi_wp_p_twe:number" }

Number Kermi_WP_P_Cool          "Aktuelle Leistung Kühlen [%.1f kW]"     <energy> (gKermiHeatpump_All, gKermiHeatpump_Control, gKermiHeatpump_Equip) ["Measurement","Power"]
    { channel="modbus:data:kermiHeatpump:kermi_wp_power:kermi_wp_p_cool:number" }

Number Kermi_WP_P_El            "El. Leistung [%.1f kW]"                 <energy> (gKermiHeatpump_All, gKermiHeatpump_Control, gKermiHeatpump_Equip) ["Measurement","Power"]
    { channel="modbus:data:kermiHeatpump:kermi_wp_power:kermi_wp_p_el:number" }

Number Kermi_WP_P_El_Heat       "El. Leistung Heizen [%.1f kW]"          <energy> (gKermiHeatpump_All, gKermiHeatpump_Control, gKermiHeatpump_Equip) ["Measurement","Power"]
    { channel="modbus:data:kermiHeatpump:kermi_wp_power:kermi_wp_p_el_heat:number" }

Number Kermi_WP_P_El_TWE        "El. Leistung TWE [%.1f kW]"             <energy> (gKermiHeatpump_All, gKermiHeatpump_Control, gKermiHeatpump_Equip) ["Measurement","Power"]
    { channel="modbus:data:kermiHeatpump:kermi_wp_power:kermi_wp_p_el_twe:number" }

Number Kermi_WP_P_El_Cool       "El. Leistung Kühlen [%.1f kW]"          <energy> (gKermiHeatpump_All, gKermiHeatpump_Control, gKermiHeatpump_Equip) ["Measurement","Power"]
    { channel="modbus:data:kermiHeatpump:kermi_wp_power:kermi_wp_p_el_cool:number" }

// --- WP Betriebsstunden ---
Number Kermi_WP_Hours_Fan           "Betriebsstunden Lüfter [%.0f h]"                <time> (gKermiHeatpump_All, gKermiHeatpump_Control, gKermiHeatpump_Equip) ["Measurement","Duration"]
    { channel="modbus:data:kermiHeatpump:kermi_wp_runtime:kermi_wp_hours_fan:number" }

Number Kermi_WP_Hours_Buffer_Pump   "Betriebsstunden Speicherladepumpe [%.0f h]"     <time> (gKermiHeatpump_All, gKermiHeatpump_Control, gKermiHeatpump_Equip) ["Measurement","Duration"]
    { channel="modbus:data:kermiHeatpump:kermi_wp_runtime:kermi_wp_hours_buffer_pump:number" }

Number Kermi_WP_Hours_Compressor    "Betriebsstunden Verdichter [%.0f h]"           <time> (gKermiHeatpump_All, gKermiHeatpump_Control, gKermiHeatpump_Equip) ["Measurement","Duration"]
    { channel="modbus:data:kermiHeatpump:kermi_wp_runtime:kermi_wp_hours_compressor:number" }

// --- WP Status ---
String Kermi_WP_Status_Code      "Status Wärmepumpe [%s]"                 <status> (gKermiHeatpump_All, gKermiHeatpump_Control, gKermiHeatpump_Equip) ["Status"]
    { channel="modbus:data:kermiHeatpump:kermi_wp_status_code_poll:kermi_wp_status_code:string" }

// --- WP Alarm ---
Switch Kermi_WP_Alarm            "Globaler Alarm"                         <error> (gKermiHeatpump_All, gKermiHeatpump_Control, gKermiHeatpump_Equip) ["Alarm"]
    { channel="modbus:data:kermiHeatpump:kermi_wp_alarm_poll:kermi_wp_alarm:switch" }

// --- WP PV Modulation ---
Switch Kermi_WP_PV_Mod_Active    "PV Modulation aktiv"                    <solarplant> (gKermiHeatpump_All, gKermiHeatpump_Control, gKermiHeatpump_Equip) ["Switch"]
    { channel="modbus:data:kermiHeatpump:kermi_wp_pv_mod:kermi_wp_pv_mod_active:switch" }

Number Kermi_WP_PV_Mod_Power     "PV-Mod aktuelle Leistung [%.1f kW]"     <solarplant> (gKermiHeatpump_All, gKermiHeatpump_Control, gKermiHeatpump_Equip) ["Measurement","Power"]
    { channel="modbus:data:kermiHeatpump:kermi_wp_pv_mod:kermi_wp_pv_mod_power:number" }

Number Kermi_WP_PV_Mod_Temp_Hz   "PV-Mod Solltemperatur Heizen [%.1f °C]" <temperature_hot> (gKermiHeatpump_All, gKermiHeatpump_Control, gKermiHeatpump_Equip) ["Setpoint","Temperature"]
    { channel="modbus:data:kermiHeatpump:kermi_wp_pv_mod:kermi_wp_pv_mod_temp_hz:number" }

Number Kermi_WP_PV_Mod_Temp_TWE  "PV-Mod Solltemperatur TWE [%.1f °C]"    <temperature_hot> (gKermiHeatpump_All, gKermiHeatpump_Control, gKermiHeatpump_Equip) ["Setpoint","Temperature"]
    { channel="modbus:data:kermiHeatpump:kermi_wp_pv_mod:kermi_wp_pv_mod_temp_twe:number" }



// ============================================================
// Bridge 2 – Kermi Speicher Heizen – Groups
// Bridge ID: kermiStoreHeating (id=50)
// ============================================================

// Technical groups
Group gKermiStoreHeat_All      "Kermi Speicher Heizen – Alle"          <heating>     (UGWaschkueche)
Group gKermiStoreHeat_Temp     "Kermi Speicher Heizen – Temperaturen"  <temperature> (gKermiStoreHeat_All)
Group gKermiStoreHeat_Control  "Kermi Speicher Heizen – Steuerung"     <settings>    (gKermiStoreHeat_All)

// Semantic equipment group for heating buffer tank
Group gKermiStoreHeat_Equip    "Heizspeicher"                          <water>       (gHVAC) ["WaterHeater"]



// ============================================================
// Bridge 2 – Kermi Speicher Heizen – Items
// Thing UID prefix: modbus:data:kermiStoreHeating:...
// ============================================================

// --- Speicher Heizen ---
Number Kermi_StoreHeat_Temp        "Isttemperatur Heizspeicher [%.1f °C]"       <temperature_hot> (gKermiStoreHeat_All, gKermiStoreHeat_Temp, gKermiStoreHeat_Equip) ["Measurement","Temperature"]
    { channel="modbus:data:kermiStoreHeating:kermi_store_heat:kermi_store_heat_temp:number" }

Number Kermi_StoreHeat_Setpoint    "Solltemperatur Heizspeicher [%.1f °C]"      <temperature_hot> (gKermiStoreHeat_All, gKermiStoreHeat_Control, gKermiStoreHeat_Equip) ["Setpoint","Temperature"]
    { channel="modbus:data:kermiStoreHeating:kermi_store_heat:kermi_store_heat_setpoint:number" }

// --- Speicher Kühlen ---
Number Kermi_StoreCool_Temp        "Isttemperatur Kühlspeicher [%.1f °C]"       <temperature_cold> (gKermiStoreHeat_All, gKermiStoreHeat_Temp, gKermiStoreHeat_Equip) ["Measurement","Temperature"]
    { channel="modbus:data:kermiStoreHeating:kermi_store_cool:kermi_store_cool_temp:number" }

Number Kermi_StoreCool_Setpoint    "Solltemperatur Kühlspeicher [%.1f °C]"      <temperature_cold> (gKermiStoreHeat_All, gKermiStoreHeat_Control, gKermiStoreHeat_Equip) ["Setpoint","Temperature"]
    { channel="modbus:data:kermiStoreHeating:kermi_store_cool:kermi_store_cool_setpoint:number" }

// --- Speicher TWE ---
Number Kermi_StoreTWE_Temp             "Isttemperatur TWE [%.1f °C]"             <temperature_hot> (gKermiStoreHeat_All, gKermiStoreHeat_Temp, gKermiStoreHeat_Equip) ["Measurement","Temperature"]
    { channel="modbus:data:kermiStoreHeating:kermi_store_twe:kermi_store_twe_temp:number" }

Number Kermi_StoreTWE_Setpoint         "Solltemperatur TWE [%.1f °C]"            <temperature_hot> (gKermiStoreHeat_All, gKermiStoreHeat_Control, gKermiStoreHeat_Equip) ["Setpoint","Temperature"]
    { channel="modbus:data:kermiStoreHeating:kermi_store_twe:kermi_store_twe_setpoint:number" }

Number Kermi_StoreTWE_Const_Setpoint   "TWE Konstant-Sollwert [%.1f °C]"         <temperature_hot> (gKermiStoreHeat_All, gKermiStoreHeat_Control, gKermiStoreHeat_Equip) ["Setpoint","Temperature"]
    { channel="modbus:data:kermiStoreHeating:kermi_store_twe:kermi_store_twe_const_setpoint:number" }

Switch Kermi_StoreTWE_One_Shot         "TWE Einmalladung"                        <switch> (gKermiStoreHeat_All, gKermiStoreHeat_Control, gKermiStoreHeat_Equip) ["Switch"]
    { channel="modbus:data:kermiStoreHeating:kermi_store_twe:kermi_store_twe_one_shot:switch" }

Number Kermi_StoreTWE_One_Shot_SP      "TWE Einmalladung Sollwert [%.1f °C]"     <temperature_hot> (gKermiStoreHeat_All, gKermiStoreHeat_Control, gKermiStoreHeat_Equip) ["Setpoint","Temperature"]
    { channel="modbus:data:kermiStoreHeating:kermi_store_twe:kermi_store_twe_one_shot_setpoint:number" }

// --- Heizkreis ---
String Kermi_HK_Status             "Status Heizkreis [%s]"                       <status> (gKermiStoreHeat_All, gKermiStoreHeat_Control, gKermiStoreHeat_Equip) ["Status"]
    { channel="modbus:data:kermiStoreHeating:kermi_hk:kermi_hk_status:string" }

Number Kermi_HK_Temp               "Isttemperatur Heizkreis [%.1f °C]"           <radiator> (gKermiStoreHeat_All, gKermiStoreHeat_Temp, gKermiStoreHeat_Equip) ["Measurement","Temperature"]
    { channel="modbus:data:kermiStoreHeating:kermi_hk:kermi_hk_temp:number" }

Number Kermi_HK_Setpoint           "Solltemperatur Heizkreis [%.1f °C]"          <radiator> (gKermiStoreHeat_All, gKermiStoreHeat_Control, gKermiStoreHeat_Equip) ["Setpoint","Temperature"]
    { channel="modbus:data:kermiStoreHeating:kermi_hk:kermi_hk_setpoint:number" }

String Kermi_HK_Mode               "Betriebsmodus Heizkreis [%s]"                <settings> (gKermiStoreHeat_All, gKermiStoreHeat_Control, gKermiStoreHeat_Equip) ["Status"]
    { channel="modbus:data:kermiStoreHeating:kermi_hk:kermi_hk_mode:string" }

String Kermi_HK_OpMode             "Betriebsart Heizkreis [%s]"                  <settings> (gKermiStoreHeat_All, gKermiStoreHeat_Control, gKermiStoreHeat_Equip) ["Status"]
    { channel="modbus:data:kermiStoreHeating:kermi_hk:kermi_hk_opmode:string" }

String Kermi_HK_EnergyMode         "Energiemodus Heizkreis [%s]"                 <energy> (gKermiStoreHeat_All, gKermiStoreHeat_Control, gKermiStoreHeat_Equip) ["Status"]
    { channel="modbus:data:kermiStoreHeating:kermi_hk:kermi_hk_energymode:string" }

Number Kermi_HK_Curve_Shift        "Parallelverschiebung Kurve [%.1f K]"         <line> (gKermiStoreHeat_All, gKermiStoreHeat_Control, gKermiStoreHeat_Equip) ["Setpoint"]
    { channel="modbus:data:kermiStoreHeating:kermi_hk:kermi_hk_curve_shift:number" }

String Kermi_HK_Season             "Saisonauswahl [%s]"                          <calendar> (gKermiStoreHeat_All, gKermiStoreHeat_Control, gKermiStoreHeat_Equip) ["Status"]
    { channel="modbus:data:kermiStoreHeating:kermi_hk:kermi_hk_season:string" }

Switch Kermi_HK_Summer_Off         "Sommerbetrieb Heizen Aus"                    <sun> (gKermiStoreHeat_All, gKermiStoreHeat_Control, gKermiStoreHeat_Equip) ["Switch"]
    { channel="modbus:data:kermiStoreHeating:kermi_hk:kermi_hk_summer_off:switch" }

Switch Kermi_HK_Winter_On          "Winterbetrieb Heizen Ein"                    <snow> (gKermiStoreHeat_All, gKermiStoreHeat_Control, gKermiStoreHeat_Equip) ["Switch"]
    { channel="modbus:data:kermiStoreHeating:kermi_hk:kermi_hk_winter_on:switch" }

Switch Kermi_HK_Cool_On            "Kühlbetrieb Ein"                             <snowflake> (gKermiStoreHeat_All, gKermiStoreHeat_Control, gKermiStoreHeat_Equip) ["Switch"]
    { channel="modbus:data:kermiStoreHeating:kermi_hk:kermi_hk_cool_on:switch" }

Switch Kermi_HK_Cool_Off           "Kühlbetrieb Aus"                             <snowflake> (gKermiStoreHeat_All, gKermiStoreHeat_Control, gKermiStoreHeat_Equip) ["Switch"]
    { channel="modbus:data:kermiStoreHeating:kermi_hk:kermi_hk_cool_off:switch" }

Switch Kermi_HK_Summer_Active      "Sommerbetrieb aktiv"                         <sun> (gKermiStoreHeat_All, gKermiStoreHeat_Control, gKermiStoreHeat_Equip) ["Status"]
    { channel="modbus:data:kermiStoreHeating:kermi_hk:kermi_hk_summer_active:switch" }

Switch Kermi_HK_Cool_Active        "Kühlbetrieb aktiv"                           <snowflake> (gKermiStoreHeat_All, gKermiStoreHeat_Control, gKermiStoreHeat_Equip) ["Status"]
    { channel="modbus:data:kermiStoreHeating:kermi_hk:kermi_hk_cool_active:switch" }

