    { channel="modbus:data:kermiStoreHeating:kermi_store_status_temp:kermi_store_t2:number" }

Number Kermi_Store_T3              "T3 X11 [%.1f °C]"                            <temperature> (gKermiStoreHeat_All, gKermiStoreHeat_Temp, gKermiStoreHeat_Equip) ["Measurement","Temperature"]
    { channel="modbus:data:kermiStoreHeating:kermi_store_status_temp:kermi_store_t3:number" }

Number Kermi_Store_T4              "T4 X10 [%.1f °C]"                            <temperature> (gKermiStoreHeat_All, gKermiStoreHeat_Temp, gKermiStoreHeat_Equip) ["Measurement","Temperature"]
