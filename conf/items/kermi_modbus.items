Number Kermi_Store_T1              "T1 X13 [%.1f °C]"                            <temperature> (gKermiStoreHeat_All, gKermiStoreHeat_Temp, gKermiStoreHeat_Equip) ["Measurement","Temperature"]
    { channel="modbus:data:kermiStoreHeating:kermi_store_status_temp:kermi_store_t1:number" }

